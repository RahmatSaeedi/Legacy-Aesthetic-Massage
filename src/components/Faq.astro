---
/**
 * Visible FAQ accordion. JSON-LD is emitted separately via <SchemaFaq> so the
 * markup and the visible content always match (a Google requirement).
 */
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((f, i) => (
      <details class="faq__item" open={i === 0}>
        <summary class="faq__q">
          <span>{f.q}</span>
          <span class="faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq__a">
          <p>{f.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq { display: grid; gap: 0.75rem; }
  .faq__item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--c-charcoal);
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    background: var(--c-bronze);
    border-radius: 2px;
  }
  .faq__icon::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .faq__icon::after { top: 0; left: 7px; width: 2px; height: 16px; transition: transform 0.2s ease; }
  .faq__item[open] .faq__icon::after { transform: rotate(90deg); opacity: 0; }
  .faq__a { padding: 0 1.25rem 1.2rem; }
  .faq__a p { color: var(--text-muted); margin: 0; }
</style>
