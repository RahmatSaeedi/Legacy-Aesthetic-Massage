---
import { Image } from 'astro:assets';
import { business, telHref, smsHref } from '../data/business';
import { servicesByOrder } from '../data/services';
import logo from '../assets/images/signature.png';

// Active-link highlighting.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services', dropdown: true },
  { href: '/about/', label: 'About' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/blog/', label: 'Journal' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header" id="site-header" data-header>
  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__loc">
        <span aria-hidden="true">📍</span> North Edmonton · Open {business.hours.display}
      </span>
      <a class="topbar__phone" href={telHref}>
        <span aria-hidden="true">📞</span> {business.phoneDisplay}
      </a>
    </div>
  </div>

  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <Image src={logo} alt={business.name} class="brand__logo" loading="eager" />
      <span class="brand__tag">Men's Spa · Edmonton</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-nav>
      <ul class="nav-list">
        {
          navLinks.map((link) =>
            link.dropdown ? (
              <li class="nav-item has-dropdown">
                <a
                  href={link.href}
                  class="nav-link"
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                  <span class="caret" aria-hidden="true">▾</span>
                </a>
                <ul class="dropdown">
                  {servicesByOrder.map((s) => (
                    <li>
                      <a href={`/services/${s.slug}/`} class="dropdown__link">
                        {s.navLabel}
                        <span class="dropdown__price">{s.price}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={link.href}
                  class="nav-link"
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            )
          )
        }
      </ul>

      <div class="nav-cta">
        <a href={telHref} class="btn btn--primary">Call {business.phoneDisplay}</a>
        <a href={smsHref} class="btn btn--ghost">Text us</a>
      </div>
    </nav>

    <div class="nav-backdrop" data-nav-backdrop></div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    /* NOTE: do not add backdrop-filter/filter/transform here — it would create a
       containing block that traps the fixed mobile menu panel inside the header. */
    background: var(--c-cream);
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.25s ease;
  }
  .site-header[data-scrolled] {
    box-shadow: var(--shadow-sm);
  }

  /* Top utility bar */
  .topbar {
    background: var(--c-espresso);
    color: var(--c-cream);
    font-size: 0.8rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.4rem;
  }
  .topbar__loc { color: rgba(250, 246, 240, 0.82); }
  .topbar__phone { color: var(--c-bronze-soft); font-weight: 600; text-decoration: none; }
  .topbar__phone:hover { color: #fff; }

  /* Main bar */
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    line-height: 1;
  }
  .brand__logo { height: 34px; width: auto; }
  .brand__tag {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-stone);
    font-weight: 600;
    padding-left: 2px;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--c-charcoal);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover { color: var(--accent-ink); background: var(--c-sand); }
  .nav-link[aria-current='page'] { color: var(--accent-ink); }
  .caret { font-size: 0.7rem; }

  /* Dropdown */
  .has-dropdown { position: relative; }
  /* Transparent hover bridge across the 6px gap so the dropdown doesn't close
     as the cursor moves from the link down to a service (desktop only). */
  @media (min-width: 921px) {
    .has-dropdown::after {
      content: '';
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 12px;
    }
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 19rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 0.5rem;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 9px;
    font-size: 0.92rem;
    color: var(--c-charcoal);
    text-decoration: none;
  }
  .dropdown__link:hover { background: var(--c-sand); color: var(--accent-ink); }
  .dropdown__price { color: var(--accent-ink); font-weight: 600; font-size: 0.85rem; }

  .nav-cta { display: none; }

  /* Hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
  }
  .nav-toggle__bar {
    width: 22px;
    height: 2px;
    background: var(--c-espresso);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 920px) {
    .topbar__loc { display: none; }
    .topbar__inner { justify-content: center; }
    .nav-toggle { display: flex; }

    .primary-nav {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(88vw, 22rem);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--c-cream);
      border-left: 1px solid var(--border);
      box-shadow: var(--shadow-lg);
      padding: 1.25rem 1.1rem 2rem;
      transform: translateX(100%);
      transition: transform 0.28s ease;
      overflow-y: auto;
      z-index: 120;
    }
    [data-header].is-open .primary-nav { transform: translateX(0); }
    [data-header].is-open .nav-toggle__bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    [data-header].is-open .nav-toggle__bar:nth-child(2) { opacity: 0; }
    [data-header].is-open .nav-toggle__bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav-list { flex-direction: column; align-items: stretch; gap: 0; margin-top: 2.5rem; }
    .nav-link { padding: 0.85rem 0.6rem; font-size: 1.05rem; border-bottom: 1px solid var(--border); border-radius: 0; }

    .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: 0;
      padding: 0 0 0.5rem;
      min-width: 0;
      background: transparent;
    }
    .dropdown__link { font-size: 0.88rem; padding: 0.5rem 1.1rem; color: var(--c-mocha); }
    .caret { display: none; }

    .nav-cta { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1.5rem; }
    .nav-cta .btn { width: 100%; }
  }

  /* Backdrop for the open mobile menu */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(42, 33, 27, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s;
    z-index: 110;
  }
  [data-header].is-open .nav-backdrop { opacity: 1; visibility: visible; }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const backdrop = document.querySelector('[data-nav-backdrop]');

  function closeMenu() {
    header?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }
  function openMenu() {
    header?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close menu');
  }

  toggle?.addEventListener('click', () => {
    header?.classList.contains('is-open') ? closeMenu() : openMenu();
  });
  backdrop?.addEventListener('click', closeMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
  // Close after navigating to an in-page link on mobile.
  document.querySelectorAll('.primary-nav a').forEach((a) =>
    a.addEventListener('click', () => {
      if (window.innerWidth <= 920) closeMenu();
    })
  );

  // Subtle shadow once scrolled.
  const onScroll = () => {
    if (window.scrollY > 8) header?.setAttribute('data-scrolled', '');
    else header?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
