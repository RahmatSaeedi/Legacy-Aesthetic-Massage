---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';

const title = "Men's Wellness & Grooming Journal | Legacy Aesthetic, Edmonton";
const description =
  "Tips and guides on massage, men's skin care, waxing, and grooming from Legacy Aesthetic men's spa in Edmonton. Get more from every treatment.";

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Journal', href: '/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <SchemaBreadcrumb slot="head" items={crumbs} />

  <PageHeader
    eyebrow="The Journal"
    title="Men's wellness & grooming"
    subtitle="Practical tips on massage, skin care, and grooming — so you get the most from every visit."
    breadcrumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <div class="post-grid">
        {
          posts.map((post) => (
            <article class="post-card">
              {post.data.heroImage && (
                <a href={`/blog/${post.id}/`} class="post-card__media" tabindex="-1" aria-hidden="true">
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.heroAlt ?? ''}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 700px) 92vw, 360px"
                    class="post-card__img"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="post-card__body">
                <time datetime={post.data.pubDate.toISOString()} class="post-card__date">
                  {fmt(post.data.pubDate)}
                </time>
                <h2 class="post-card__title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="post-card__excerpt">{post.data.description}</p>
                <span class="post-card__more">Read article →</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.8rem;
  }
  .post-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
    overflow: hidden; box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .post-card__media { display: block; aspect-ratio: 3 / 2; overflow: hidden; }
  .post-card__img { width: 100%; height: 100%; object-fit: cover; }
  .post-card__body { display: flex; flex-direction: column; flex: 1; padding: 1.3rem; }
  .post-card__date { font-size: 0.8rem; color: var(--c-stone); text-transform: uppercase; letter-spacing: 0.06em; }
  .post-card__title { font-size: 1.45rem; margin: 0.4rem 0 0.5rem; }
  .post-card__title a { color: inherit; text-decoration: none; }
  .post-card__title a:hover { color: var(--accent-ink); }
  .post-card__excerpt { font-size: 0.94rem; flex: 1; }
  .post-card__more { margin-top: 1rem; font-size: 0.85rem; font-weight: 600; color: var(--accent-ink); }
</style>
