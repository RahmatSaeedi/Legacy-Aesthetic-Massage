---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SchemaFaq from '../components/seo/SchemaFaq.astro';
import { business, telHref, smsHref } from '../data/business';
import { servicesByOrder } from '../data/services';
import { generalFaqs } from '../data/faqs';

import heroImg from '../assets/images/Massage_3.jpg';
import studioImg from '../assets/images/Massage_4.jpg';
import ownerImg from '../assets/images/Taz_Saeedi.png';

const title = "Legacy Aesthetic Men's Spa — Massage & Grooming in North Edmonton";
const description =
  'A private men’s spa in north Edmonton offering relaxation & deep-tissue massage, body exfoliation, facials, waxing, cupping and haircuts. Open 9am–9pm daily. Call or text 587-712-0719.';

const features = [
  {
    icon: '🌿',
    title: 'Made for men',
    text: 'Massage, skin, and grooming services tailored to men’s needs — never one-size-fits-all.',
  },
  {
    icon: '🔒',
    title: 'Private & discreet',
    text: 'One-on-one care in a calm, private studio. You’re professionally draped and always comfortable.',
  },
  {
    icon: '🕯️',
    title: 'Genuinely relaxing',
    text: 'A warm, unhurried atmosphere — no conveyor-belt appointments, just focused attention on you.',
  },
  {
    icon: '📅',
    title: 'Open late, every day',
    text: '9 AM to 9 PM, Monday through Sunday, with same-day appointments often available.',
  },
];
---

<BaseLayout title={title} description={description}>
  <SchemaFaq slot="head" faqs={generalFaqs} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__media">
      <Image
        src={heroImg}
        alt="A man relaxing during a warm candle-lit back massage at Legacy Aesthetic men's spa in Edmonton"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <div class="hero__scrim"></div>
    </div>
    <div class="container hero__content">
      <p class="hero__eyebrow">Edmonton's Premier Men's Spa</p>
      <h1 class="hero__title">Relax, unwind,<br />and feel your best.</h1>
      <p class="hero__sub">
        Massage, skin care, and grooming for men — in a warm, private studio in
        north Edmonton. Same-day appointments, open 9&nbsp;AM to 9&nbsp;PM every day.
      </p>
      <div class="btn-row">
        <a href={telHref} class="btn btn--primary">Call {business.phoneDisplay}</a>
        <a href={smsHref} class="btn btn--light">Text to book</a>
      </div>
      <ul class="hero__badges">
        <li><span class="stars" aria-hidden="true">★★★★★</span> Loved by Edmonton men</li>
        <li>Private &amp; discreet</li>
        <li>Open daily · 9am–9pm</li>
      </ul>
    </div>
  </section>

  <!-- WELCOME -->
  <section class="section">
    <div class="container welcome">
      <div class="section-head">
        <p class="eyebrow">Welcome to Legacy Aesthetic</p>
        <h2>Premium grooming &amp; wellness, designed around you</h2>
        <hr class="rule" />
      </div>
      <p class="lead">
        Step into a men's spa where relaxation meets refinement. From rejuvenating
        massage and body treatments to expert grooming, every visit is meticulously
        designed to leave you refreshed, renewed, and polished — all in one calm,
        private place in north Edmonton.
      </p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--sand" id="services">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Our Services</p>
        <h2>Everything you need, all in one place</h2>
        <hr class="rule" />
        <p class="lead">
          Massage, skin and body care, and men's grooming — choose a single treatment
          or combine a few into your own reset.
        </p>
      </div>
      <div class="services-grid">
        {servicesByOrder.map((s, i) => <ServiceCard service={s} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="section">
    <div class="container why">
      <div class="why__media">
        <Image
          src={studioImg}
          alt="A relaxing private home massage studio with a warm, professional atmosphere in north Edmonton"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 92vw, 460px"
          class="why__img"
          loading="lazy"
        />
      </div>
      <div class="why__copy">
        <p class="eyebrow">Why Legacy Aesthetic</p>
        <h2>A calmer, more personal kind of spa</h2>
        <hr class="rule" />
        <ul class="feature-list">
          {features.map((f) => (
            <li class="feature">
              <span class="feature__icon" aria-hidden="true">{f.icon}</span>
              <div>
                <h3 class="feature__title">{f.title}</h3>
                <p class="feature__text">{f.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- MEET TAZ -->
  <section class="section section--ink">
    <div class="container meet">
      <div class="meet__photo">
        <Image
          src={ownerImg}
          alt="Taz Saeedi, licensed aesthetician and owner of Legacy Aesthetic Men's Spa in Edmonton"
          widths={[240, 360, 480]}
          sizes="(max-width: 760px) 60vw, 300px"
          class="meet__img"
          loading="lazy"
        />
      </div>
      <div class="meet__copy">
        <p class="eyebrow">Meet your therapist</p>
        <h2>Hi, I'm Taz</h2>
        <hr class="rule" />
        <p>
          As a licensed aesthetician, I've built Legacy Aesthetic around one simple
          idea: men deserve a space to truly relax and take care of themselves. Every
          treatment is hands-on, unhurried, and tailored to you — whether you're here
          to release tension, refresh your skin, or simply switch off for an hour.
        </p>
        <a href="/about/" class="btn btn--outline-light">More about Taz &amp; the studio</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Reviews</p>
        <h2>What our clients say</h2>
        <hr class="rule" />
      </div>
      <Testimonials />
      <div class="reviews-cta">
        <a href="/reviews/" class="btn btn--ghost">Read more reviews</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container-narrow">
      <div class="section-head center">
        <p class="eyebrow">Good to know</p>
        <h2>Frequently asked questions</h2>
        <hr class="rule" />
      </div>
      <Faq faqs={generalFaqs} />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; display: flex; align-items: center; min-height: min(82vh, 720px); overflow: hidden; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 14, 10, 0.82) 0%, rgba(20, 14, 10, 0.55) 45%, rgba(20, 14, 10, 0.2) 100%),
      linear-gradient(0deg, rgba(20, 14, 10, 0.5), rgba(20, 14, 10, 0) 40%);
  }
  .hero__content { position: relative; z-index: 1; color: #fff; padding-block: 4rem; max-width: 44rem; }
  .hero__eyebrow {
    font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase;
    font-weight: 600; color: var(--c-bronze-soft); margin-bottom: 1rem;
  }
  .hero__title { color: #fff; font-size: var(--fs-900); line-height: 1.05; }
  .hero__sub { color: rgba(255, 255, 255, 0.88); font-size: var(--fs-500); margin-top: 1.1rem; max-width: 36rem; }
  .hero .btn-row { margin-top: 1.8rem; }
  .hero__badges {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; list-style: none; padding: 0;
    margin-top: 2rem; font-size: 0.85rem; color: rgba(255, 255, 255, 0.82);
  }
  .hero__badges li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .hero__badges .stars { color: var(--c-bronze-soft); letter-spacing: 0.08em; }

  /* WELCOME */
  .welcome { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2.5rem; align-items: center; }
  .welcome .lead { color: var(--c-charcoal); }
  @media (max-width: 800px) { .welcome { grid-template-columns: 1fr; gap: 1.2rem; } }

  /* SERVICES */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.6rem;
    margin-top: 2.5rem;
  }

  /* WHY */
  .why { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: center; }
  .why__img { width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); aspect-ratio: 4 / 3; object-fit: cover; }
  .feature-list { list-style: none; padding: 0; margin: 1.8rem 0 0; display: grid; gap: 1.4rem; }
  .feature { display: flex; gap: 1rem; }
  .feature__icon {
    flex-shrink: 0; width: 2.9rem; height: 2.9rem; display: grid; place-items: center;
    background: var(--c-sand); border-radius: 50%; font-size: 1.3rem;
  }
  .feature__title { font-size: 1.3rem; margin-bottom: 0.15rem; }
  .feature__text { font-size: 0.95rem; }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr; gap: 1.8rem; } }

  /* MEET */
  .meet { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 2.5rem; align-items: center; }
  .meet__photo { display: flex; justify-content: center; }
  .meet__img {
    width: 100%; max-width: 300px; border-radius: var(--radius-lg);
    background: linear-gradient(160deg, rgba(176, 130, 74, 0.25), rgba(176, 130, 74, 0.05));
  }
  .meet__copy { max-width: 40rem; }
  @media (max-width: 760px) { .meet { grid-template-columns: 1fr; text-align: center; } .meet .rule { margin-inline: auto; } .meet__img { max-width: 220px; } }

  /* REVIEWS */
  .reviews-cta { text-align: center; margin-top: 2.2rem; }
</style>
