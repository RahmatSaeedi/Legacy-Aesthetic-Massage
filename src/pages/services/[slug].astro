---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import SchemaService from '../../components/seo/SchemaService.astro';
import SchemaFaq from '../../components/seo/SchemaFaq.astro';
import SchemaBreadcrumb from '../../components/seo/SchemaBreadcrumb.astro';
import { services, servicesByOrder, type Service } from '../../data/services';
import { business, telHref, smsHref } from '../../data/business';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.name, href: `/services/${service.slug}/` },
];

const others = servicesByOrder.filter((s) => s.slug !== service.slug);
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  image={service.image.src}
>
  <SchemaService slot="head" service={service} />
  <SchemaFaq slot="head" faqs={service.faqs} />
  <SchemaBreadcrumb slot="head" items={crumbs} />

  <!-- HEADER -->
  <section class="svc-head">
    <div class="container svc-head__inner">
      <div class="svc-head__copy">
        <Breadcrumbs items={crumbs} />
        <span class="svc-tag">{service.category}</span>
        <h1>{service.title}</h1>
        <p class="lead">{service.intro}</p>
        <p class="svc-price">
          <strong>{service.price}</strong>
          {service.priceNote && <span> {service.priceNote}</span>}
          {service.duration && <span class="svc-dur"> · {service.duration}</span>}
        </p>
        <div class="btn-row">
          <a href={telHref} class="btn btn--primary">Call {business.phoneDisplay}</a>
          <a href={smsHref} class="btn btn--ghost">Text to book</a>
        </div>
      </div>
      <div class="svc-head__media">
        <Image
          src={service.image}
          alt={service.imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 92vw, 480px"
          loading="eager"
          fetchpriority="high"
          class="svc-head__img"
        />
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="section">
    <div class="container svc-layout">
      <article class="svc-main">
        {service.body.map((p) => <p>{p}</p>)}

        <div class="inline-cta">
          <div class="inline-cta__copy">
            <strong>Ready to book your {service.name.toLowerCase()}?</strong>
            <span>Call or text {business.phoneDisplay} — same-day appointments often available.</span>
          </div>
          <div class="inline-cta__btns">
            <a href={telHref} class="btn btn--primary">Call now</a>
            <a href={smsHref} class="btn btn--ghost">Text us</a>
          </div>
        </div>

        <h2>Benefits</h2>
        <ul class="check-list">
          {service.benefits.map((b) => <li>{b}</li>)}
        </ul>

        {service.process && (
          <>
            <h2>What to expect</h2>
            <ol class="steps">
              {service.process.map((step) => (
                <li>
                  <span class="steps__label">{step.step}</span>
                  <span class="steps__text">{step.text}</span>
                </li>
              ))}
            </ol>
          </>
        )}

        {service.goodFor && (
          <>
            <h2>Great for</h2>
            <ul class="check-list">
              {service.goodFor.map((g) => <li>{g}</li>)}
            </ul>
          </>
        )}

        <h2>Questions about {service.name.toLowerCase()}</h2>
        <Faq faqs={service.faqs} />
      </article>

      <aside class="svc-aside">
        <div class="book-card">
          <p class="book-card__eyebrow">Book this service</p>
          <p class="book-card__price">{service.price}<small>{service.priceNote ? ` ${service.priceNote}` : ''}</small></p>
          <p class="book-card__hours">Open {business.hours.display}</p>
          <div class="book-card__actions">
            <a href={telHref} class="btn btn--primary">Call {business.phoneDisplay}</a>
            <a href={smsHref} class="btn btn--ghost">Text us</a>
          </div>
          <p class="book-card__note">{business.address.note}</p>
        </div>

        <nav class="other-services" aria-label="Other services">
          <h2 class="other-services__title">Other services</h2>
          <ul>
            {others.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>
                  <span>{s.navLabel}</span>
                  <span class="other-services__price">{s.price}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  </section>

  <CtaBanner title={`Book your ${service.name.toLowerCase()}`} />
</BaseLayout>

<style>
  /* HEADER */
  .svc-head { background: var(--c-sand); border-bottom: 1px solid var(--border); }
  .svc-head__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(2rem, 1.2rem + 3vw, 3.4rem);
  }
  .svc-tag {
    display: inline-block; margin: 1rem 0 0.6rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent-ink); background: rgba(176, 130, 74, 0.14);
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill);
  }
  .svc-head h1 { font-size: var(--fs-800); }
  .svc-head .lead { margin-top: 0.9rem; color: var(--c-charcoal); }
  .svc-price { margin-top: 1.1rem; font-size: 1.05rem; color: var(--text-muted); }
  .svc-price strong { font-size: 1.5rem; color: var(--accent-ink); font-family: var(--font-serif); }
  .svc-dur { color: var(--c-stone); }
  .svc-head .btn-row { margin-top: 1.4rem; }
  .svc-head__img { width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); aspect-ratio: 3 / 2; object-fit: cover; }

  /* BODY LAYOUT */
  .svc-layout { display: grid; grid-template-columns: 1fr 20rem; gap: 3rem; align-items: start; }
  .svc-main > p { margin-bottom: 1.1rem; font-size: 1.06rem; }
  .svc-main h2 { font-size: var(--fs-600); margin: 2.2rem 0 1rem; }
  .svc-main h2:first-of-type { margin-top: 1.6rem; }

  .inline-cta {
    display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; flex-wrap: wrap;
    background: var(--c-sand); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 1.3rem 1.4rem; margin: 1.8rem 0 0.5rem;
  }
  .inline-cta__copy { display: flex; flex-direction: column; }
  .inline-cta__copy strong { font-family: var(--font-serif); font-size: 1.3rem; color: var(--c-espresso); line-height: 1.2; }
  .inline-cta__copy span { color: var(--text-muted); font-size: 0.92rem; margin-top: 0.2rem; }
  .inline-cta__btns { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .check-list { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  .check-list li { position: relative; padding-left: 1.9rem; color: var(--text-muted); }
  .check-list li::before {
    content: '✓'; position: absolute; left: 0; top: 0;
    width: 1.35rem; height: 1.35rem; display: grid; place-items: center;
    background: rgba(125, 138, 114, 0.18); color: var(--c-sage);
    border-radius: 50%; font-size: 0.78rem; font-weight: 700;
  }

  .steps { list-style: none; padding: 0; counter-reset: step; display: grid; gap: 1rem; }
  .steps li { position: relative; padding-left: 3.2rem; counter-increment: step; }
  .steps li::before {
    content: counter(step); position: absolute; left: 0; top: -2px;
    width: 2.2rem; height: 2.2rem; display: grid; place-items: center;
    background: var(--c-espresso); color: #fff; border-radius: 50%;
    font-family: var(--font-serif); font-weight: 600;
  }
  .steps__label { display: block; font-weight: 600; color: var(--c-charcoal); }
  .steps__text { color: var(--text-muted); }

  /* ASIDE */
  .svc-aside { position: sticky; top: calc(var(--header-h) + 1.5rem); display: grid; gap: 1.5rem; }
  .book-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md); padding: 1.5rem;
  }
  .book-card__eyebrow {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--accent-ink); margin-bottom: 0.4rem;
  }
  .book-card__price { font-family: var(--font-serif); font-size: 2rem; color: var(--c-espresso); line-height: 1; }
  .book-card__price small { font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-muted); font-weight: 500; }
  .book-card__hours { font-size: 0.9rem; margin: 0.6rem 0 1.1rem; }
  .book-card__actions { display: grid; gap: 0.6rem; }
  .book-card__note { font-size: 0.82rem; color: var(--c-stone); margin-top: 1rem; }

  .other-services__title { font-size: 1.1rem; margin-bottom: 0.6rem; }
  .other-services ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
  .other-services a {
    display: flex; justify-content: space-between; gap: 1rem; align-items: center;
    padding: 0.6rem 0.2rem; border-bottom: 1px solid var(--border);
    text-decoration: none; color: var(--c-charcoal); font-size: 0.92rem;
  }
  .other-services a:hover { color: var(--accent-ink); }
  .other-services__price { color: var(--accent-ink); font-weight: 600; font-size: 0.82rem; }

  @media (max-width: 900px) {
    .svc-head__inner { grid-template-columns: 1fr; }
    .svc-head__media { order: -1; }
    .svc-layout { grid-template-columns: 1fr; gap: 2.2rem; }
    .svc-aside { position: static; }
  }
</style>
